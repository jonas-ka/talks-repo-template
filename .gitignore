# Build outputs and intermediates (PPTX exports are covered by *.pptx above)
talks/**/*.pdf
talks/**/*.html
talks/**/png/
build/
work/

# Generated contact sheets with embedded images (CSV review sheets are tracked)
review/**/*.html
review/**/thumbs/

# Credentials
credentials.json
token.json
.env
*.pem

# Local Claude Code settings
.claude/settings.local.json

# HTML slideshow exports are regenerated by `talks html`
talks/**/index.html
talks/**/*.html
spikes/**/*.html
spikes/**/*.svg

# Proof-of-compile output of `talks freeze`
talks/**/frozen.pdf
!assets/figures/plot-ion-optics-beam-at-detector-planes-poster-v5.svg
!assets/figures/plot-ion-optics-beam-at-detector-planes-poster-v6.svg
