# Python / uv
.venv/
__pycache__/
*.pyc
*.egg-info/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# macOS
.DS_Store

# Editable originals live in Drive, not here
*.key
*.pptx
*.gslides

# Archive binaries are regenerated by `talks export` (1.6 GB of PDFs exceeds the
# free LFS quota); only manifest.yaml and slides.json are tracked.
archive/**/*.pdf
archive/**/media/

# Course documents: PDFs and HTML are built by `talks course build` and published to Drive
courses/**/*.pdf
courses/**/*.html

# SVG twins of vector figures are regenerated by `talks catalog` (Typst needs them,
# git does not: they double the size of assets/figures/)
assets/figures/*.svg
# ... except hand-added figures that exist only as SVG (no PDF original to regenerate from);
# add a line here for every such figure (`talks catalog` never rebuilds them)
!assets/figures/plot-us-cpi-u-yoy-2023-2026.svg
!assets/figures/logo-karthein-lab-sticker.svg
!assets/figures/plot-oxygen-charge-radii-exp-theo.svg
!assets/figures/plot-vision-h200-throughput.svg
!assets/figures/plot-vision-h200-step-time.svg
!assets/figures/plot-vision-h200-throughput-poster.svg
!assets/figures/plot-ion-optics-tracker-mrtof-twin.svg
!assets/figures/plot-ion-optics-tracker-mrtof-twin-poster.svg
