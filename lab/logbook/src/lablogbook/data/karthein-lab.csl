<?xml version="1.0" encoding="utf-8"?>
<!--
  Lab short citation, for log-book entries (lab-templates logbook/). In the text:
    article   Karthein J.++ Phys. Rev. Lett. 123, 456 (2019)
    one author Solo H. Nat. Phys. 16, 1 (2020)
    book      Writer A.++ Ion Traps (Springer, 2001)
  "++" stands for "and others". The journal is the short title (`shortjournal` in the .bib,
  from Crossref); the renderers link the whole citation to its DOI.
  Keep titles' capitals with double braces in the .bib: title = {{Ion Traps}}.
-->
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="en-US">
  <info>
    <title>Karthein Lab short citation</title>
    <id>karthein-lab-short</id>
    <updated>2026-10-13T00:00:00+00:00</updated>
  </info>
  <locale xml:lang="en">
    <terms>
      <term name="et-al">++</term>
    </terms>
  </locale>
  <macro name="author">
    <names variable="author editor">
      <!-- delimiter "" with delimiter-precedes-et-al="always" puts "++" right after "J." -->
      <name name-as-sort-order="all" sort-separator=" " initialize-with="." et-al-min="2"
            et-al-use-first="1" delimiter="" delimiter-precedes-et-al="always"/>
      <et-al term="et-al"/>
    </names>
  </macro>
  <citation>
    <layout delimiter="; ">
      <group delimiter=" ">
        <text macro="author"/>
        <choose>
          <if type="book">
            <text variable="title" font-style="italic"/>
            <group prefix="(" suffix=")" delimiter=", ">
              <text variable="publisher"/>
              <date variable="issued"><date-part name="year"/></date>
            </group>
          </if>
          <else-if variable="container-title">
            <group delimiter=", ">
              <group delimiter=" ">
                <text variable="container-title" form="short"/>
                <text variable="volume"/>
              </group>
              <text variable="page-first"/>
            </group>
            <date variable="issued" prefix="(" suffix=")"><date-part name="year"/></date>
          </else-if>
          <else>
            <text variable="title"/>
            <date variable="issued" prefix="(" suffix=")"><date-part name="year"/></date>
          </else>
        </choose>
      </group>
    </layout>
  </citation>
  <macro name="all-authors">
    <names variable="author editor">
      <name name-as-sort-order="all" sort-separator=" " initialize-with="." delimiter=", "/>
    </names>
  </macro>
  <!-- The reference list: all authors, the title, the short citation's source, and the DOI. -->
  <bibliography>
    <sort><key macro="all-authors"/><key variable="issued"/></sort>
    <layout>
      <group delimiter=". ">
        <text macro="all-authors"/>
        <text variable="title"/>
        <choose>
          <if type="book">
            <group delimiter=", "><text variable="publisher"/><date variable="issued"><date-part name="year"/></date></group>
          </if>
          <else>
            <group delimiter=" ">
              <group delimiter=", ">
                <group delimiter=" "><text variable="container-title" form="short"/><text variable="volume"/></group>
                <text variable="page-first"/>
              </group>
              <date variable="issued" prefix="(" suffix=")"><date-part name="year"/></date>
            </group>
          </else>
        </choose>
        <choose>
          <if variable="DOI"><text variable="DOI" prefix="https://doi.org/"/></if>
          <else-if variable="ISBN"><text variable="ISBN" prefix="ISBN "/></else-if>
        </choose>
      </group>
    </layout>
  </bibliography>
</style>
